rules_version = '2';

// ============================================================
// Reglas de Firestore · Eight Academy POA
//
// Esto vive en el servidor de Firebase y es la única barrera que
// cuenta. Aunque alguien edite el JavaScript en su navegador, no
// puede leer ni escribir nada que estas reglas no permitan.
//
// Se pegan en: Firebase → Firestore Database → Reglas → Publicar
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Identidad verificada y del dominio institucional.
    function delDominio() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email is string
          && request.auth.token.email.lower().matches('^[^@]+@eightacademy[.]edu[.]ec$');
    }

    // Super administradores: los únicos que escriben.
    // Para dar de alta a alguien, añade su correo AQUÍ y también en
    // public/config.js. Si solo lo pones allá, la pantalla le mostrará
    // los botones pero el servidor le rechazará cada cambio.
    function esAdmin() {
      return delDominio()
          && request.auth.token.email.lower() in [
               'mibermeov@eightacademy.edu.ec',
               'dsroblesl@eightacademy.edu.ec',
               'lemaciasb@eightacademy.edu.ec'
             ];
    }

    function areaValida(area) {
      return area in [
        'KIDS', 'PRIMARIA', 'SECUNDARIA', 'DECE',
        'MARKETING', 'RIESGOS', 'ZOOBOTANICA'
      ];
    }

    function poaValido(area) {
      return areaValida(area)
          && request.resource.data.keys().hasOnly(['area', 'events', 'n'])
          && request.resource.data.area is string
          && request.resource.data.area == area
          && request.resource.data.events is list
          && request.resource.data.events.size() <= 300
          && request.resource.data.n is int
          && request.resource.data.n == request.resource.data.events.size();
    }

    function metaValida() {
      return request.resource.data.keys().hasOnly([
               'generated', 'total', 'corrections', 'subidoPor', 'subidoEl'
             ])
          && request.resource.data.generated is string
          && request.resource.data.generated.size() <= 100
          && request.resource.data.total is int
          && request.resource.data.total >= 0
          && request.resource.data.total <= 2100
          && request.resource.data.corrections is list
          && request.resource.data.corrections.size() <= 200
          && request.resource.data.subidoPor is string
          && request.resource.data.subidoPor.lower() == request.auth.token.email.lower()
          && request.resource.data.subidoEl is string
          && request.resource.data.subidoEl.size() <= 40;
    }

    function cambioValido() {
      return request.resource.data.actualizadoPor is string
          && request.resource.data.actualizadoPor.lower() == request.auth.token.email.lower()
          && request.resource.data.actualizadoEl is timestamp;
    }

    // Las actividades, un documento por área.
    match /poa/{area} {
      allow read:  if delDominio();
      allow create, update: if esAdmin() && poaValido(area);
      allow delete: if false;
    }

    // Fecha de generación y demás datos del conjunto.
    match /meta/general {
      allow read:  if delDominio();
      allow create, update: if esAdmin() && metaValida();
      allow delete: if false;
    }

    // Cada importación conserva una copia inmutable de sus datos.
    match /importaciones/{version} {
      allow read: if esAdmin();
      allow create: if esAdmin() && metaValida();
      allow update, delete: if false;

      match /poa/{area} {
        allow read: if esAdmin();
        allow create: if esAdmin() && poaValido(area);
        allow update, delete: if false;
      }
    }

    match /revisiones/{hallazgo} {
      allow read: if delDominio();
      allow create, update: if esAdmin()
          && hallazgo.matches('^[a-z0-9]{1,16}$')
          && request.resource.data.keys().hasOnly([
               'revisado', 'actualizadoPor', 'actualizadoEl'
             ])
          && request.resource.data.keys().hasAll([
               'revisado', 'actualizadoPor', 'actualizadoEl'
             ])
          && cambioValido()
          && request.resource.data.revisado is bool;
      allow delete: if false;
    }

    match /clasificaciones/{actividad} {
      allow read: if delDominio();
      allow create, update: if esAdmin()
          && actividad.matches('^[0-9]{1,10}$')
          && request.resource.data.keys().hasOnly([
               'clase', 'actualizadoPor', 'actualizadoEl'
             ])
          && request.resource.data.keys().hasAll([
               'clase', 'actualizadoPor', 'actualizadoEl'
             ])
          && cambioValido()
          && request.resource.data.clase in [
               'grande', 'mediana', 'pequena', 'ninguna'
             ];
      allow delete: if false;
    }

    // Registro inmutable de cada edición y aprobación de documentos.
    match /ediciones/{edicion} {
      allow read: if esAdmin();
      allow create: if esAdmin()
          && request.resource.data.keys().hasOnly([
               'actor', 'fecha', 'version', 'tipo', 'etiqueta', 'cambios'
             ])
          && request.resource.data.keys().hasAll([
               'actor', 'fecha', 'version', 'tipo', 'etiqueta', 'cambios'
             ])
          && request.resource.data.actor is string
          && request.resource.data.actor.lower() == request.auth.token.email.lower()
          && request.resource.data.fecha is timestamp
          && request.resource.data.version is string
          && request.resource.data.version.size() <= 40
          && request.resource.data.tipo in ['edicion','importacion']
          && request.resource.data.etiqueta is string
          && request.resource.data.etiqueta.size() <= 150
          && request.resource.data.cambios is list
          && request.resource.data.cambios.size() > 0
          && request.resource.data.cambios.size() <= 200;
      allow update, delete: if false;
    }

    // Casilla "minuto a minuto entregado": detiene los avisos por correo.
    match /entregas/{actividad} {
      allow read: if delDominio();
      allow create, update: if esAdmin()
          && actividad.matches('^[0-9]{1,10}$')
          && request.resource.data.keys().hasOnly([
               'entregado', 'actualizadoPor', 'actualizadoEl'
             ])
          && request.resource.data.keys().hasAll([
               'entregado', 'actualizadoPor', 'actualizadoEl'
             ])
          && cambioValido()
          && request.resource.data.entregado is bool;
      allow delete: if false;
    }

    // Estado y registro de los avisos. Solo los escribe el script de envío,
    // que entra con permiso de IAM y no pasa por estas reglas.
    match /avisos/{actividad} {
      allow read: if delDominio();
      allow write: if false;
    }
    match /registroAvisos/{envio} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Responsables, copias, días no laborables y modo de envío. Todo el personal
    // la lee para que el tablero calcule las fechas con los mismos días hábiles.
    match /config/avisos {
      allow read: if delDominio();
      allow create, update: if esAdmin()
          && request.resource.data.keys().hasOnly([
               'modo', 'inicio', 'correoPrueba', 'correoErrores', 'responsables',
               'copias', 'noLaborables', 'actualizadoPor', 'actualizadoEl'
             ])
          && request.resource.data.keys().hasAll([
               'modo', 'inicio', 'responsables', 'copias', 'noLaborables',
               'actualizadoPor', 'actualizadoEl'
             ])
          && cambioValido()
          && request.resource.data.modo in ['prueba', 'activo', 'pausado']
          && request.resource.data.inicio is string
          && request.resource.data.inicio.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.responsables is map
          && request.resource.data.copias is list
          && request.resource.data.copias.size() <= 30
          && request.resource.data.noLaborables is list
          && request.resource.data.noLaborables.size() <= 150;
      allow delete: if false;
    }

    // Todo lo que no esté declarado arriba queda cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
